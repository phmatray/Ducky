<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <Description>R3 reactive effects for Ducky: a ReactiveEffect turns the action stream and the state into observables, for debouncing, cancelling stale requests, polling and other time-based workflows.</Description>
    <PackageTags>ducky;reactive;r3;observable;rx;effects;state-management</PackageTags>
    <!-- Off here: pinning would promote Ducky's Extensions abstractions to direct nuspec dependencies, outside this
         package's SPEC §3 row; they flow through the Ducky dependency at the same version. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ducky.Reactive.Tests" Key="$(DuckyPublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="none": the Ducky dependency keeps its generator and buildTransitive assets (R-PKG-5). -->
    <ProjectReference Include="../Ducky/Ducky.csproj" PrivateAssets="none" />
    <PackageReference Include="R3" />
  </ItemGroup>
</Project>
