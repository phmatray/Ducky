<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Razor SDK: only it turns wwwroot/ducky.js into the static web asset _content/Ducky.Blazor/ducky.js (SPEC §3). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <Description>Blazor integration for Ducky: components that re-render when a selected value changes, browser storage and IDistributedCache persistence, the prerender state handoff, cross-tab sync and Redux DevTools, in the WebAssembly, Server and Auto render modes.</Description>
    <PackageTags>blazor;state-management;redux;flux;webassembly;persistence;prerender;devtools;ducky</PackageTags>
    <!-- Off here: pinning would promote Ducky's Extensions abstractions to direct nuspec dependencies, outside this
         package's SPEC §3 row; they flow through the Ducky dependency at the same version. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <!-- The Razor SDK makes every *.json a packed Content item: the mutation config (read from the directory by Stryker)
         must never ship to consumers (SPEC §3 layout). -->
    <Content Remove="stryker-config.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ducky.Blazor.Tests" Key="$(DuckyPublicKey)" />
    <InternalsVisibleTo Include="Ducky.Blazor.Generated.Tests" Key="$(DuckyPublicKey)" />
    <InternalsVisibleTo Include="Ducky.Concurrency.Tests" Key="$(DuckyPublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="none": the Ducky dependency keeps its generator and buildTransitive assets (R-PKG-5). -->
    <ProjectReference Include="../Ducky/Ducky.csproj" PrivateAssets="none" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
  </ItemGroup>
</Project>
