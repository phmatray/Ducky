<Project Sdk="Microsoft.Build.NoTargets/3.7.134">
  <!-- The final Ducky.Generator package (SPEC §3, ADR-0045): no assembly, only buildTransitive/Ducky.Generator.targets. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Ducky.Generator</PackageId>
    <Version>2.0.0</Version>
    <MinVerSkip>true</MinVerSkip>
    <EnablePackageValidation>false</EnablePackageValidation>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageOutputPath>$(RepoRoot)artifacts/tombstone/</PackageOutputPath>
    <Description>Deprecated: the Ducky source generator ships inside the Ducky package from 2.0. Remove this reference.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="buildTransitive/Ducky.Generator.targets" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
</Project>
