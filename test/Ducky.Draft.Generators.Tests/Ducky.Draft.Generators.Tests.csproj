<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Verify's solution discovery sees three .slnx files at the root and warns; name the one this project belongs to. -->
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(RepoRoot)</SolutionDir>
    <SolutionName Condition="'$(SolutionName)' == ''">Ducky</SolutionName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ducky.Draft.Generators/Ducky.Draft.Generators.csproj" />
    <!-- The real Ducky.Draft.dll for test compilations, never stubs (GEN-06, SPEC §16.1). -->
    <ProjectReference Include="../../src/Ducky.Draft/Ducky.Draft.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <PackageReference Include="Verify.SourceGenerators" />
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/Property.cs" Link="Shared/Property.cs" />
    <Compile Include="../Shared/StaticFieldAudit.cs" Link="Shared/StaticFieldAudit.cs" />
    <None Include="../../build/property-seeds.txt" Link="property-seeds.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
