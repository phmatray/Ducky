<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The normal install (SPEC §17.9 step 1, R-PKG-5): only Ducky.Blazor, so Ducky and its buildTransitive/Ducky.targets
       arrive transitively: it compiles the generated Increment helper and AddDuckyGenerated_Ducky_PackageSmoke_BlazorOnly().
       A web project, so its DUCKY004 variant (-p:SmokeSingleton=true) proves the CompilerVisibleProperty items flow too.
       Its DUCKY900 variant sets -p:SmokeLegacyGenerator=1.0.292 (the committed fake). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/Counter.cs" Link="Counter.cs" />
    <PackageReference Include="Ducky.Blazor" Version="$(DuckyVersion)" />
    <PackageReference Include="Ducky.Generator" Version="$(SmokeLegacyGenerator)" Condition="'$(SmokeLegacyGenerator)' != ''" />
  </ItemGroup>
</Project>
