<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- WASM consumer (SPEC §17.9 step 1): compiles against the packed Ducky and Ducky.Blazor with TreatWarningsAsErrors,
       calling AddDuckyGenerated_PackageSmoke() (hence the assembly name) and the generated Increment helper. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PackageSmoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/Counter.cs" Link="Counter.cs" />
    <PackageReference Include="Ducky" Version="$(DuckyVersion)" />
    <PackageReference Include="Ducky.Blazor" Version="$(DuckyVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
  </ItemGroup>
</Project>
