<?xml version="1.0" encoding="utf-8"?>
<!-- PackageSmoke feeds (SPEC §17.9): Ducky, Ducky.*, Ducky.Generator and Mutty come only from the local feeds, so the real
     Ducky.Generator and Ducky.Blazor 1.0.292 on nuget.org can never shadow the committed fakes in feed/. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="packages" value="../../artifacts/packages" />
    <add key="tombstone" value="../../artifacts/tombstone" />
    <add key="feed" value="feed" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="packages">
      <package pattern="Ducky" />
      <package pattern="Ducky.*" />
      <package pattern="Ducky.Generator" />
      <package pattern="Mutty" />
    </packageSource>
    <packageSource key="tombstone">
      <package pattern="Ducky" />
      <package pattern="Ducky.*" />
      <package pattern="Ducky.Generator" />
      <package pattern="Mutty" />
    </packageSource>
    <packageSource key="feed">
      <package pattern="Ducky" />
      <package pattern="Ducky.*" />
      <package pattern="Ducky.Generator" />
      <package pattern="Mutty" />
    </packageSource>
  </packageSourceMapping>
</configuration>
