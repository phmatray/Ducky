<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <DuckyUseGenerators>true</DuckyUseGenerators>
    <DuckyUseDraftGenerator>true</DuckyUseDraftGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ducky/Ducky.csproj" />
    <ProjectReference Include="../../src/Ducky.Testing/Ducky.Testing.csproj" />
    <!-- The Blazor, Reactive and Draft guides (M15-03). -->
    <ProjectReference Include="../../src/Ducky.Blazor/Ducky.Blazor.csproj" />
    <ProjectReference Include="../../src/Ducky.Reactive/Ducky.Reactive.csproj" />
    <ProjectReference Include="../../src/Ducky.Draft/Ducky.Draft.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Blazor guides' Program.cs snippets: WebApplication, IsDevelopment() and AddDistributedMemoryCache. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/Property.cs" Link="Shared/Property.cs" />
    <None Include="../../build/property-seeds.txt" Link="property-seeds.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
