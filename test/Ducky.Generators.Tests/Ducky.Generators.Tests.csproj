<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Verify's solution discovery sees three .slnx files at the root and warns; name the one this project belongs to. -->
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(RepoRoot)</SolutionDir>
    <SolutionName Condition="'$(SolutionName)' == ''">Ducky</SolutionName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ducky.Generators/Ducky.Generators.csproj" />
    <!-- The real Ducky.dll for test compilations, never stubs (GEN-06, SPEC §16.1). -->
    <ProjectReference Include="../../src/Ducky/Ducky.csproj" />
    <!-- The real Ducky.Blazor.dll for the GEN-02 gates on its methods (GEN-06, SPEC §16.1). -->
    <ProjectReference Include="../../src/Ducky.Blazor/Ducky.Blazor.csproj" />
    <!-- The real Ducky.Testing.dll for the TestStore arms of DUCKY010 and DUCKY021, copied next to the tests as a file
         only: referencing it would make this a Ducky.Testing test project (§17.8) though no test runs its code. -->
    <ProjectReference Include="../../src/Ducky.Testing/Ducky.Testing.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
    <!-- The real Ducky.Draft.dll for DUCKY003's Draft-receiver exemption, copied next to the tests as a file only, like
         Ducky.Testing.dll: Ducky.Generators matches its types by metadata name and never references it. -->
    <ProjectReference Include="../../src/Ducky.Draft/Ducky.Draft.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <PackageReference Include="Verify.SourceGenerators" />
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <!-- DUCKY009: the Razor source generator as a plain reference; ExcludeAssets keeps the toolset's build targets out. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Net.Compilers.Razor.Toolset" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <Reference Include="$(PkgMicrosoft_Net_Compilers_Razor_Toolset)/source-generators/Microsoft.CodeAnalysis.Razor.Compiler.dll" />
    <Reference Include="$(PkgMicrosoft_Net_Compilers_Razor_Toolset)/source-generators/Microsoft.AspNetCore.Razor.Utilities.Shared.dll" />
    <Reference Include="$(PkgMicrosoft_Net_Compilers_Razor_Toolset)/source-generators/Microsoft.Extensions.ObjectPool.dll" />
  </ItemGroup>

  <!-- DUCKY006/025: the System.Text.Json source generator the SDK runs on this project, as a plain reference, so the
       verifier runs the real one (DUCKY006 reads its output). -->
  <Target Name="ReferenceJsonSourceGenerator" AfterTargets="ResolveTargetingPackAssets">
    <ItemGroup>
      <Reference Include="@(Analyzer)" Condition="'%(Filename)' == 'System.Text.Json.SourceGeneration'" Private="true" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/Property.cs" Link="Shared/Property.cs" />
    <Compile Include="../Shared/StaticFieldAudit.cs" Link="Shared/StaticFieldAudit.cs" />
    <None Include="../../build/property-seeds.txt" Link="property-seeds.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
