<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- The generated MTP entry point names global::{RootNamespace}.SelfRegisteredExtensions; under Ducky.Concurrency.Tests
         that collides with the public enum Ducky.Concurrency (CS0435, SPEC §5.5). -->
    <RootNamespace>Ducky.ConcurrencyTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ducky/Ducky.csproj" />
    <ProjectReference Include="../../src/Ducky.Blazor/Ducky.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
