<Project>
  <!-- Repository-wide defaults (SPEC §18). Kind-specific analyzers and ban lists live in Directory.Build.targets. -->

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <DuckyIsSrcProject>$(MSBuildProjectDirectory.StartsWith('$(RepoRoot)src$([System.IO.Path]::DirectorySeparatorChar)'))</DuckyIsSrcProject>
    <DuckyIsTestProject>$(MSBuildProjectDirectory.StartsWith('$(RepoRoot)test$([System.IO.Path]::DirectorySeparatorChar)'))</DuckyIsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGetAudit advisories never fail PR builds; only the nightly Audit target enforces them (SPEC §17.1). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- R-PKG-6: only the six shipping projects opt back in. -->
    <IsPackable>false</IsPackable>
    <!-- Anchored: a relative path would resolve per project, into src/<Project>/artifacts/. -->
    <PackageOutputPath>$(RepoRoot)artifacts/packages/</PackageOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DuckyIsSrcProject)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- src/ and test/ are signed alike, so friend assemblies (R-PKG-2) never hit CS1726. -->
  <PropertyGroup Condition="'$(DuckyIsSrcProject)' == 'true' or '$(DuckyIsTestProject)' == 'true'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(RepoRoot)ducky.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Full public key of ducky.snk, for <InternalsVisibleTo Include="X" Key="$(DuckyPublicKey)" />. -->
    <DuckyPublicKey></DuckyPublicKey>
  </PropertyGroup>
</Project>
