<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!--
      S-1 (R-PKG-3): generator floor. SDK 10.0.100 ships Roslyn 5.0.0-2.25523.111
      (sdk/10.0.100/Roslyn/bincore/csc.deps.json), i.e. Microsoft.CodeAnalysis.CSharp 5.0.0.
      A higher version makes consumers on SDK 10.0.100 fail with CS9057. Never bump:
      Renovate ignores it (.github/renovate.json); spikes/S-1-roslyn-floor proves it.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />

    <!-- Ducky's only runtime dependencies (SPEC §3). -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />

    <!-- Ducky.Blazor's runtime dependencies (SPEC §3), added with the features that use them. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.14" />

    <!-- R3 1.3.x: plain version, pinned by the lock file, packed as R3 >= 1.3.x (SPEC §3). -->
    <PackageVersion Include="R3" Version="1.3.1" />

    <!-- Test stack. test/BannedSymbols.covered.txt lists CsCheck.Check overloads of this exact version: on a bump, run the check mode of test/banned-ids.cs, which fails on a stale ID or a new unbanned threads overload (Renovate asks for approval). -->
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <!-- Ducky.Blazor.Tests: PersistStorage.Server runs against the real MemoryDistributedCache (SPEC §11.6, §17.2). -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <!-- Ducky.Blazor.Tests: the Interactive Server data protection the prerender seed's wire estimate covers (SPEC §11.4). -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <!-- Generator snapshots (SPEC §16.1, GEN-06): Verify.SourceGenerators over the xUnit v3 adapter. 32.0.1 is the last
         MIT Verify: 33.x ships under an EULA whose SponsorCheck fails the build until a sponsorship or exemption is
         declared, an owner decision (.github/renovate.json holds the major). -->
    <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
    <PackageVersion Include="Verify.XunitV3" Version="32.0.1" />
    <!-- Analyzer verifier tests (SPEC §16.2). Its Workspaces dependency floats at 1.0.1: pinned here to the Roslyn floor above. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <!-- DUCKY009 tests (SPEC §16.2): the real Razor source generator in the driver, taken from the Razor toolset package
         (its source-generators folder, never its build targets). This build targets Roslyn 4.14, so it loads on the S-1
         floor; the SDK's own copy and the Microsoft.CodeAnalysis.Razor.Compiler package need a newer Roslyn or a
         dependency that isn't on nuget.org. -->
    <PackageVersion Include="Microsoft.Net.Compilers.Razor.Toolset" Version="9.0.0-preview.25264.2" />
    <!-- Component tests (SPEC §17.2: bUnit 2.x, sets RendererInfo). -->
    <PackageVersion Include="bunit" Version="2.11.3" />
    <!-- MTP extensions behind the coverage (cobertura) and TRX options of dotnet test (SPEC §17.2, §19). -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />

    <!-- Audit (SPEC §17.1): transitive pins of patched versions. 10.0.12 and 9.0.6 have high advisories (GHSA-846f-f764-76mx,
         GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83), reached through Microsoft.AspNetCore.DataProtection
         (Ducky.Blazor.Tests), the analyzer testing stack (the generator tests) and Fallout (build/); no src/ project uses them. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />

    <!-- samples/Ducky.Samples.Server (+ .Client, Interactive Auto, SPEC §18). WebAssembly.Server 10.0.14 is the first
         release without GHSA-g27p-qf6j-c96c and GHSA-qjpx-jqm5-h2c4; it needs WebAssembly 10.0.14, which needs the
         10.0.14 Components and Microsoft.Extensions packages, so every 10.0.x pin above moves with it and transitive
         pinning stays on everywhere. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <!-- samples/Ducky.Samples.Wasm (SPEC §18): the dev server for `dotnet run` of the standalone sample. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />

    <!-- benchmarks/Ducky.Benchmarks (SPEC §17.1): the informational nightly Benchmarks target. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />

    <!-- Fallout build (SPEC §19, ADR-0035): exact pin. -->
    <PackageVersion Include="Fallout.Common" Version="[10.4.0]" />
    <PackageVersion Include="Fallout.Components" Version="[10.4.0]" />
    <!-- The Docs target's static documentation site (SPEC §19): Markdown to HTML. -->
    <PackageVersion Include="Markdig" Version="1.6.0" />

    <!-- Build analyzers (SPEC §17.1). Verified to load in SDK 10.0.100's compiler (no CS9057); Renovate asks for approval and a 10.0.100 build on a bump. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one versioning system (SPEC §19): tag prefix and minimum in Directory.Build.props. -->
    <GlobalPackageReference Include="MinVer" Version="8.0.0" />
  </ItemGroup>
</Project>
