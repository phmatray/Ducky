@* Every keystroke dispatches TypeSearch; the Switch effect decides which one the
   warehouse hears about. *@
@inherits ShopComponent

<section class="region search" style="--i: 1" aria-label="Search the shop">
  @RenderCount
  <div class="xtags">
    <XrayTag FeatureId="search" Detail="@($"{_search.Value.Superseded} superseded")" />
  </div>
  <label class="search-field">
    <span class="sr-only">Search the ducks</span>
    <Icon Name="search" />
    <input type="search" value="@_search.Value.Query" @oninput="OnInput"
           placeholder="Try cursed, blue or state"
           autocomplete="off" spellcheck="false" />
  </label>
  <p class="search-status">
    <span class="phase">@PhaseText</span>
    <span class="xray-only superseded">@SupersededText</span>
  </p>
</section>

@code {
  private Selection<SearchState> _search = null!;

  private string PhaseText => _search.Value switch
  {
    { Phase: SearchPhase.Waiting } => "Waiting for a pause in your typing",
    { Phase: SearchPhase.Fetching } search =>
      $"Asking the warehouse about “{search.Term}”",
    _ => "",
  };

  private string SupersededText => _search.Value switch
  {
    { Superseded: 0 } =>
      "Type fast: Switch cancels every run a newer keystroke overtakes.",
    { Superseded: 1 } search =>
      $"1 run superseded ({search.CancelledInFlight} in flight)",
    var search =>
      $"{search.Superseded} runs superseded ({search.CancelledInFlight} in flight)",
  };

  protected override void OnInitialized() =>
    _search = Select<SearchState, SearchState>(static search => search);

  private void OnInput(ChangeEventArgs e) => Store.TypeSearch(e.Value as string ?? "");
}
