@* After each Produce edit, the panel compares the new profile with the previous one by
   reference to show which records were rebuilt and which were kept. *@
@inherits ShopComponent

@{ var profile = TrackSharing(); }
<section class="region profile" style="--i: 4" aria-labelledby="profile-title">
  @RenderCount
  <div class="xtags"><XrayTag FeatureId="profile" Detail="@_sharingDetail" /></div>
  <h2 id="profile-title" class="side-title">Deliver to</h2>

  @if (!_editing)
  {
    <address>
      @profile.Name<br />
      @profile.Address.Street<br />
      @profile.Address.Postcode @profile.Address.City<br />
      @profile.Address.Country
    </address>
    <p class="side-note">@DeliveryNote(profile.Delivery)</p>
    <button @ref="_editButton" type="button" class="pill small" aria-expanded="false"
            @onclick="() => SetEditing(true)">
      <Icon Name="edit" Size="16" /> Edit
    </button>
  }
  else
  {
    <form id="profile-form" class="form" @onsubmit="() => SetEditing(false)">
      <label class="field">
        <span>Name</span>
        <input @ref="_firstField" value="@profile.Name" autocomplete="name"
               @onchange="e => Edit(ProfileField.Name, e)" />
      </label>
      @Field("Email", ProfileField.Email, profile.Email, "email")
      @Field("Street", ProfileField.Street, profile.Address.Street, "street-address")
      <div class="form-pair">
        @Field("Postcode", ProfileField.Postcode, profile.Address.Postcode, "postal-code")
        @Field("City", ProfileField.City, profile.Address.City, "address-level2")
      </div>
      @Field("Country", ProfileField.Country, profile.Address.Country, "country-name")
      @Field("Instructions", ProfileField.Instructions, profile.Delivery.Instructions,
             "off")
      <label class="check">
        <input type="checkbox" checked="@profile.Delivery.LeaveWithNeighbour"
               @onchange="e => Store.SetLeaveWithNeighbour(e.Value is true)" />
        May be left with a neighbour
      </label>
      <button type="submit" class="pill small">Done</button>
    </form>
  }
  <p class="xray-only side-note">@_sharingNote</p>
</section>

@code {
  private Selection<Profile> _profile = null!;
  private Profile? _previous;
  private string? _sharingDetail;
  private string _sharingNote =
    "Edit a field: Produce rebuilds only the records on the path to it.";
  private bool _editing;
  private bool _focusPending;
  private ElementReference _editButton;
  private ElementReference _firstField;

  protected override void OnInitialized() =>
    _profile = Select<Profile, Profile>(static profile => profile);

  // Focus follows the toggle: into the form's first field on Edit, back to Edit on Done.
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusPending)
    {
      _focusPending = false;
      await (_editing ? _firstField : _editButton).FocusAsync();
    }
  }

  private static string DeliveryNote(Delivery delivery)
  {
    var handover = delivery.LeaveWithNeighbour
      ? "May be left with a neighbour."
      : "Hand it to me in person.";
    return $"{handover} {delivery.Instructions}";
  }

  private void SetEditing(bool editing)
  {
    _editing = editing;
    _focusPending = true;
  }

  // Each field dispatches on change (blur or Enter): one EditProfile per edit, not per
  // key.
  private void Edit(ProfileField field, ChangeEventArgs e) =>
    Store.EditProfile(field, e.Value as string ?? string.Empty);

  private RenderFragment Field(
    string label,
    ProfileField field,
    string value,
    string autocomplete) => __builder =>
    {
      <label class="field">
        <span>@label</span>
        <input value="@value" autocomplete="@autocomplete"
               @onchange="e => Edit(field, e)" />
      </label>
    };

  // Read while rendering, so tracking costs no extra render.
  private Profile TrackSharing()
  {
    var current = _profile.Value;
    if (_previous is not null && !ReferenceEquals(_previous, current))
    {
      var kept = new List<string>();
      var rebuilt = new List<string> { "Profile" };
      void Classify(string record, bool sameInstance) =>
        (sameInstance ? kept : rebuilt).Add(record);
      Classify("Address", ReferenceEquals(_previous.Address, current.Address));
      Classify("Delivery", ReferenceEquals(_previous.Delivery, current.Delivery));

      _sharingDetail = kept.Count == 0
        ? "all rebuilt"
        : $"kept {string.Join(", ", kept)}";
      var keptNote = kept.Count == 0
        ? "nothing was kept."
        : $"{string.Join(" and ", kept)} is the same instance as before.";
      _sharingNote =
        $"The last edit built a new {string.Join(" and ", rebuilt)}; {keptNote}";
    }
    _previous = current;
    return current;
  }
}
