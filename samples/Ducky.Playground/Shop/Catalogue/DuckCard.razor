@* Each card selects its own duck and basket quantity by id, so adding a duck re-renders
   only its card. Add awaits the dispatch to learn whether the middleware vetoed it. *@
@inherits ShopComponent
@inject Tape Tape

<li class="duck">
  @RenderCount
  @if (_duck.Value is { } duck)
  {
    <DuckGlyph Colour="duck.Colour" />
    <h3 class="duck-name">@duck.Name</h3>
    <p class="duck-blurb">@duck.Blurb</p>
    <p class="duck-tags">
      <span class="tag">@duck.Colour</span>
      @foreach (var tag in duck.Tags)
      {
        <span class="tag">@tag</span>
      }
    </p>
    <div class="duck-buy">
      <span class="price">@Money.Format(duck.Price)</span>
      <span class="@StockClass(duck)">@StockLabel(duck)</span>
      <button type="button" class="add" disabled="@(!duck.InStock)"
              aria-label="Add @duck.Name to the basket" @onclick="AddAsync">
        <Icon Name="plus" Size="18" /> Add
      </button>
    </div>
    @if (_inBasket.Value > 0)
    {
      <p class="in-basket">
        <Icon Name="check" Size="16" /> @_inBasket.Value in your basket
      </p>
    }
    @if (_veto is not null)
    {
      <p class="veto" role="status">Vetoed: @_veto</p>
    }
  }
</li>

@code {
  private Selection<Duck?> _duck = null!;
  private Selection<int> _inBasket = null!;
  private string? _veto;

  [Parameter, EditorRequired] public string DuckId { get; set; } = "";

  protected override void OnInitialized()
  {
    _duck = Select<CatalogueState, Duck?>(catalogue => catalogue.Ducks.Find(DuckId));
    _inBasket = Select<BasketState, int>(basket => basket.QuantityOf(DuckId));
  }

  private static string StockClass(Duck duck) =>
    duck.Stock is > 0 and < 5 ? "stock low" : "stock";

  private static string StockLabel(Duck duck) => duck.Stock switch
  {
    0 => "Sold out",
    < 5 => $"Only {duck.Stock} left",
    _ => $"{duck.Stock} in stock",
  };

  private async Task AddAsync()
  {
    var result = await Store.AddToBasketAsync(DuckId);
    if (result != DispatchResult.Vetoed)
    {
      _veto = null;
      return;
    }

    // Vetoed: nothing was reduced. The same shop rule the middleware applied says why.
    _veto = ShopRules.RefusalReason(Store.State, DuckId) ?? "the shop refused it.";
    Tape.Vetoed(AddToBasket.Type, $"{_duck.Value?.Name}: {_veto}");
  }
}
