@* The shelf selects a memoized selector with a comparer: it re-renders only when the
   visible ids change, never for a stock or basket change. *@
@inherits ShopComponent

<section class="region shelf-region" style="--i: 3" aria-labelledby="shelf-title">
  @RenderCount
  <div class="xtags">
    <XrayTag FeatureId="catalogue" Detail="@CatalogueDetail" />
    <XrayTag FeatureId="veto" />
  </div>
  <h2 id="shelf-title" class="shelf-title"><span aria-live="polite">@Heading</span></h2>

  @if (_loading.Value)
  {
    <p class="shelf-note">Unpacking the ducks…</p>
  }
  else if (_error.Value is { } error)
  {
    <p class="shelf-note" role="alert">The warehouse didn't answer: @error</p>
  }
  else if (_visibleIds.Value.IsEmpty)
  {
    <p class="shelf-note">
      No duck answers to that. Try “yellow”, “cursed” or “state”, or clear the
      filters.
    </p>
  }
  else
  {
    <ul class="shelf" role="list">
      @foreach (var id in _visibleIds.Value)
      {
        <DuckCard @key="id" DuckId="@id" />
      }
    </ul>
  }
</section>

@code {
  private Selection<ImmutableArray<string>> _visibleIds = null!;
  private Selection<int> _total = null!;
  private Selection<bool> _loading = null!;
  private Selection<string?> _error = null!;

  private string CatalogueDetail => $"{_visibleIds.Value.Length} of {_total.Value}";

  private string Heading => (_loading.Value, _visibleIds.Value.Length) switch
  {
    (true, _) => "Ducks",
    (_, 1) => "1 duck",
    (_, var count) => $"{count} ducks",
  };

  protected override void OnInitialized()
  {
    // The comparer keeps this render when the same ids come back, even if a stock
    // changed.
    _visibleIds = Select(ShelfSelectors.VisibleIds.Create(), ShelfSelectors.SameIds);
    _total = Select<CatalogueState, int>(static catalogue => catalogue.Ducks.Count);
    _loading = Select<CatalogueState, bool>(static catalogue => catalogue.Loading);
    _error = Select<CatalogueState, string?>(static catalogue => catalogue.Error);
  }
}
