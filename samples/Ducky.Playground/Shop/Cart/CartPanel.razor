@inherits ShopComponent
@using System.Globalization
@using System.Text.Json.Nodes
@inject Tape Tape
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject TimeProvider Time

<section class="region basket" style="--i: 1" id="basket" aria-labelledby="basket-title">
  @RenderCount
  <div class="xtags"><XrayTag Feature="basket" Detail="@(_restored.Value ? "restored on load" : "v2, synced")" /></div>
  <h2 id="basket-title" class="side-title">Basket <span class="count">@Count</span></h2>

  @if (_lines.Value.IsEmpty)
  {
    <p class="side-note">Empty for now. Every duck on the shelf has an Add button.</p>
  }
  else
  {
    <ul class="lines" role="list">
      @foreach (var line in _lines.Value)
      {
        <li @key="line.DuckId">
          <span class="line-name">@line.Name</span>
          <span class="stepper">
            <button type="button" aria-label="One fewer @line.Name" @onclick="() => Store.RemoveOneFromCart(line.DuckId)"><Icon Name="minus" Size="16" /></button>
            <span class="qty" aria-label="@line.Quantity in the basket">@line.Quantity</span>
            <button type="button" aria-label="One more @line.Name" @onclick="() => OneMoreAsync(line)"><Icon Name="plus" Size="16" /></button>
          </span>
          <span class="line-total">@DuckColours.Price(line.Total)</span>
          <button type="button" class="remove" aria-label="Remove @line.Name" @onclick="() => Store.RemoveCartLine(line.DuckId)"><Icon Name="close" Size="16" /></button>
        </li>
      }
    </ul>
    <p class="total"><span>Total</span><b>@DuckColours.Price(_lines.Value.Sum(static line => line.Total))</b></p>
  }
  @if (_veto is not null)
  {
    <p class="veto" role="status">Vetoed: @_veto</p>
  }

  <a class="text-link" href="./" target="_blank" rel="noopener">Open this shop in another tab <Icon Name="tab" Size="16" /></a>
  <div class="xray-only tools">
    <p>Version 1 of this shop stored the basket as a map. Plant such an entry and reload: the migration turns it into lines.</p>
    <button type="button" class="pill small" @onclick="PlantVersionOneAsync">Plant a version-1 basket and reload</button>
  </div>
</section>

@code {
  private Selection<ImmutableList<OrderLine>> _lines = null!;
  private Selection<bool> _restored = null!;
  private string? _veto;

  private string Count => _lines.Value.Sum(static line => line.Quantity) switch
  {
    0 => "",
    1 => "1 duck",
    var count => $"{count} ducks",
  };

  protected override void OnInitialized()
  {
    _lines = Select(Pricing.BasketLines.Create());
    // True once the basket came back from localStorage when this store started (the load rule's check).
    _restored = Select(static state => state.WasRestored<Basket>());
  }

  private async Task OneMoreAsync(OrderLine line)
  {
    var result = await Store.AddToCartAsync(line.DuckId);
    _veto = result == DispatchResult.Vetoed ? $"{line.Name}: {ShopRules.WhyNot(Store.State, line.DuckId) ?? "the shop refused it."}" : null;
    if (_veto is not null)
    {
      Tape.Vetoed(AddToCart.Type, _veto);
    }
  }

  // Exactly what version 1 wrote: the map shape in a version-1 envelope, under the basket's key. After the reload the
  // store reads it, runs Migrate(1, ...) over the JSON, and restores the lines.
  private async Task PlantVersionOneAsync()
  {
    var entry = new JsonObject
    {
      ["v"] = 1,
      ["at"] = Time.GetUtcNow().ToString("O", CultureInfo.InvariantCulture),
      ["s"] = new JsonObject { ["Items"] = new JsonObject { [Stockroom.ClassicId] = 3, [Stockroom.CursedId] = 1 } },
    };
    await Js.InvokeVoidAsync("localStorage.setItem", $"{CartPersistence.KeyPrefix}:cart", entry.ToJsonString());
    Navigation.Refresh(forceReload: true);
  }
}
