@* The dispatcher board: an ink tape docked at the bottom. Collapsed, it shows the newest
   row; expanded, the ruled log, plus the payload and state diff of the row you open. *@
@inherits DuckyComponent
@using System.Globalization
@using System.Text.Json.Nodes
@inject Tape Tape
@inject XrayStore Xray

<section id="inspector" class="tape region @(_open.Value ? "open" : null)"
         aria-label="Inspector">
  <div class="tape-bar">
    <h2 class="tape-title">Inspector</h2>
    <div class="xtags">
      <XrayTag FeatureId="audit" Detail="@($"{Tape.Total} rows")" />
    </div>
    @if (Tape.Latest() is { } latest)
    {
      <p class="tape-latest" aria-live="off">
        <span class="seq">@SequenceText(latest)</span>
        <code class="type">@latest.ActionType</code>
        <span class="origin">@latest.Origin</span>
        @LampBadge(latest.Lamp)
      </p>
    }
    <p class="tape-counts">
      <span>@Tape.Total rows</span>
      @if (Tape.DroppedCount > 0)
      {
        <span class="lamp dropped">@Tape.DroppedCount dropped</span>
      }
      @if (Tape.VetoedCount > 0)
      {
        <span class="lamp vetoed">@Tape.VetoedCount vetoed</span>
      }
      @if (Tape.FailedCount > 0)
      {
        <span class="lamp failed">@Tape.FailedCount failed</span>
      }
    </p>
    <button type="button" class="pill on-ink tape-toggle"
            aria-expanded="@(_open.Value ? "true" : "false")" aria-controls="tape-log"
            @onclick="Xray.ToggleInspector">
      <Icon Name="@(_open.Value ? "down" : "up")" Size="16" />
      <span class="tape-toggle-text">@(_open.Value ? "Collapse" : "Expand")</span>
      <span class="sr-only"> the inspector</span>
    </button>
  </div>

  @if (_open.Value)
  {
    var rows = Tape.Rows();
    var selected = rows.FirstOrDefault(row => row.Number == _selectedNumber)
      ?? rows.FirstOrDefault();
    <div class="tape-body" id="tape-log">
      <div class="board-wrap" tabindex="-1">
        <table class="board">
          <caption class="sr-only">
            Every action the store processed, newest first
          </caption>
          <colgroup>
            <col class="c-seq" />
            <col class="c-time" />
            <col class="c-act" />
            <col class="c-org" />
            <col class="c-res" />
          </colgroup>
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Time</th>
              <th scope="col">Action</th>
              <th scope="col">Origin</th>
              <th scope="col">Result</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var row in rows)
            {
              <tr @key="row.Number" class="@(row == selected ? "selected" : null)">
                <td>@SequenceText(row)</td>
                <td>@row.Time</td>
                <td>
                  <button type="button" class="row-open"
                          aria-pressed="@(row == selected ? "true" : "false")"
                          @onclick="() => _selectedNumber = row.Number">
                    @row.ActionType
                  </button>
                  @if (row.Note is not null)
                  {
                    <em title="@row.Note">@row.Note</em>
                  }
                </td>
                <td>@row.Origin</td>
                <td>@LampBadge(row.Lamp)</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
      <div class="tape-detail">
        @if (selected is not null)
        {
          var detail = DetailOf(selected);
          <h3><code>@selected.ActionType</code></h3>
          <p class="detail-label">Payload</p>
          <pre class="detail-code">@detail.Payload</pre>
          <p class="detail-label">State changed</p>
          @if (detail.Changes.Count == 0)
          {
            <p class="detail-none">@NothingChanged(selected.Lamp)</p>
          }
          else
          {
            <ul class="diff" role="list">
              @foreach (var change in detail.Changes)
              {
                <li>
                  <code class="path">@change.Path</code>
                  <code class="before">@(change.Before ?? "(none)")</code>
                  <code class="after">@(change.After ?? "(removed)")</code>
                </li>
              }
            </ul>
          }
        }
      </div>
    </div>
  }
</section>

@code {
  private Selection<bool> _open = null!;
  private long _selectedNumber = -1;
  private bool _renderQueued;
  private (long Number, Lamp Lamp, RowDetail Detail)? _cachedDetail;

  private sealed record RowDetail(string Payload, IReadOnlyList<DiffLine> Changes);

  protected override void OnInitialized()
  {
    _open = Select<XrayView, bool>(static view => view.InspectorOpen);
    Tape.Changed += OnTapeChanged;
  }

  // The tape changes on the store's drainer, often several times per user action: queue
  // one render per batch instead of one per row.
  private void OnTapeChanged()
  {
    if (_renderQueued)
    {
      return;
    }
    _renderQueued = true;
    _ = InvokeAsync(() =>
    {
      _renderQueued = false;
      StateHasChanged();
    });
  }

  private static string SequenceText(TapeRow row) =>
    row.Sequence?.ToString(CultureInfo.InvariantCulture) ?? "–";

  private static string NothingChanged(Lamp lamp) => lamp == Lamp.Reduced
    ? "Nothing: every slice returned the same instance."
    : "Nothing was committed.";

  private static RenderFragment LampBadge(Lamp lamp) => __builder =>
  {
    <span class="lamp @lamp.ToString().ToLowerInvariant()">@lamp</span>
  };

  // Cached for the selected row; rebuilt when its lamp changes, as a row can turn Failed.
  private RowDetail DetailOf(TapeRow row)
  {
    if (_cachedDetail is { } cached
      && cached.Number == row.Number
      && cached.Lamp == row.Lamp)
    {
      return cached.Detail;
    }

    var detail = new RowDetail(PayloadOf(row), ChangesOf(row));
    _cachedDetail = (row.Number, row.Lamp, detail);
    return detail;
  }

  private string PayloadOf(TapeRow row) => row.Action switch
  {
    null => row.Note ?? "(none)",
    EffectFailed failed => $"EffectType  {failed.EffectType}\n"
      + $"ActionType  {failed.ActionType}\n"
      + $"{failed.Exception.GetType().Name}: {failed.Exception.Message}",
    ReducerFailed failed => $"ActionType  {failed.ActionType}\n"
      + $"SliceKey    {failed.SliceKey}\n"
      + $"{failed.Exception.GetType().Name}: {failed.Exception.Message}",
    var action when Store.Json.TrySerialize(action, action.GetType(), out var json) =>
      JsonNode.Parse(json)?.ToJsonString(StateDiff.Indented) ?? json,
    _ => "(no payload: a SliceStore method's change, "
      + "or a library action outside the app's JSON context)",
  };

  // Each changed slice is serialized through the app's JSON context and diffed leaf by
  // leaf.
  private List<DiffLine> ChangesOf(TapeRow row)
  {
    var changes = new List<DiffLine>();
    if (row is not { Before: { } before, After: { } after })
    {
      return changes;
    }

    foreach (var key in row.ChangedKeys)
    {
      var stateType = Store.Slices.FirstOrDefault(slice => slice.Key == key)?.StateType;
      if (stateType is null || !before.Keys.Contains(key) || !after.Keys.Contains(key))
      {
        continue;
      }
      var beforeNode = Store.Json.ToNode(before.Get(key), stateType);
      var afterNode = Store.Json.ToNode(after.Get(key), stateType);
      changes.AddRange(StateDiff.Compare(beforeNode, afterNode, key));
    }
    return changes;
  }

  protected override void Dispose(bool disposing)
  {
    if (disposing)
    {
      Tape.Changed -= OnTapeChanged;
    }
    base.Dispose(disposing);
  }
}
