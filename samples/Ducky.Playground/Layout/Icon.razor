@* The playground's icons: one 24-unit grid, a 2.4 stroke, round caps, currentColor. *@
<svg class="icon" viewBox="0 0 24 24" width="@Size" height="@Size"
     aria-hidden="true" focusable="false" fill="none" stroke="currentColor"
     stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
  @switch (Name)
  {
    case "search":
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="M15.5 15.5 21 21" />
      break;
    case "plus":
      <path d="M12 5v14M5 12h14" />
      break;
    case "minus":
      <path d="M5 12h14" />
      break;
    case "close":
      <path d="M6 6l12 12M18 6 6 18" />
      break;
    case "tab":
      <path d="M14 4h6v6M20 4l-9 9" />
      <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
      break;
    case "code":
      <path d="M8.5 7 3.5 12l5 5M15.5 7l5 5-5 5" />
      break;
    case "up":
      <path d="M6 15l6-6 6 6" />
      break;
    case "down":
      <path d="M6 9l6 6 6-6" />
      break;
    case "basket":
      <path d="M3.5 9h17l-1.8 10a1 1 0 0 1-1 .8H6.3a1 1 0 0 1-1-.8z" />
      <path d="M8 9l3-5M16 9l-3-5" />
      break;
    case "check":
      <path d="M5 12.5l4.2 4L19 7" />
      break;
    case "edit":
      <path d="M4 20h4L19 9l-4-4L4 16z" />
      <path d="M13.5 6.5l4 4" />
      break;
    case "restock":
      <path d="M4 12a8 8 0 0 1 13.6-5.7L20 8.5" />
      <path d="M20 4v4.5h-4.5" />
      <path d="M20 12a8 8 0 0 1-13.6 5.7L4 15.5" />
      <path d="M4 20v-4.5h4.5" />
      break;
  }
</svg>

@code {
  [Parameter, EditorRequired] public string Name { get; set; } = "";

  [Parameter] public int Size { get; set; } = 20;
}
