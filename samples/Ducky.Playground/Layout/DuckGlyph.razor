@* The site's duck redrawn as a product silhouette in the duck's own colour, its beak
   contrasting with the body. Decorative: the duck's name is the text beside it. *@
<svg class="duck-glyph" viewBox="0 0 400 360" aria-hidden="true" focusable="false">
  <g stroke="@Ink" stroke-width="16" stroke-linejoin="round" fill="@_bodyFill">
    <path d="@BodyPath" />
    <circle cx="152" cy="128" r="84" />
  </g>
  <path d="@WingPath" fill="none" stroke="@_detail" stroke-width="11"
        stroke-linejoin="round" stroke-linecap="round" />
  <path d="@BeakPath" fill="@_beak" stroke="@Ink" stroke-width="11"
        stroke-linejoin="round" />
  <circle cx="132" cy="108" r="14" fill="@_detail" />
  <circle cx="137" cy="103" r="4.5" fill="@_glint" />
</svg>

@code {
  private const string Ink = "#17140F";
  private const string Yolk = "#FFD425";
  private const string White = "#FFFFFF";

  private const string BodyPath = "M58 252C58 206 104 186 168 190L292 196"
    + "C324 188 344 162 350 128C382 166 390 236 364 276"
    + "C338 318 276 338 204 338C114 338 58 304 58 252Z";

  private const string WingPath = "M196 262C226 226 290 222 324 250"
    + "M214 286C250 296 290 290 318 272";

  private const string BeakPath = "M80 126C52 120 26 130 16 146C34 162 60 168 88 160Z";

  private string _bodyFill = "";
  private string _detail = "";
  private string _beak = "";
  private string _glint = "";

  [Parameter] public DuckColour Colour { get; set; }

  // Ink details on a light duck; on a black duck the details turn white and the beak
  // yolk.
  protected override void OnParametersSet()
  {
    var isBlack = Colour == DuckColour.Black;
    _bodyFill = DuckColours.Hex(Colour);
    _detail = isBlack ? White : Ink;
    _beak = isBlack ? Yolk : Ink;
    _glint = isBlack ? Ink : White;
  }
}
