@inherits ShopComponent
@inject IJSRuntime Js
@* Phones: the basket sits below the shelf, so a sticky pill jumps to it. *@

@if (_count.Value > 0)
{
  <a class="cart-jump" href="#basket" @onclick="JumpAsync" @onclick:preventDefault><Icon Name="basket" Size="18" /> Basket, @(_count.Value == 1 ? "1 duck" : $"{_count.Value} ducks")</a>
}

@code {
  private Selection<int> _count = null!;

  // Scrolled and focused in place: under the base href, "#basket" alone would load another document when the URL has a query.
  private async Task JumpAsync() => await Js.InvokeVoidAsync("playground.jump", "basket");

  protected override void OnInitialized() => _count = Select<Basket, int>(static basket => basket.Count);
}
