@* The page: top bar, the shop sheet, the code drawer and the inspector tape. X-ray is one
   class on the desk; tags, outlines and render counters are CSS, so flipping it
   re-renders only the components that selected it. *@
@inherits ShopComponent
@inject IJSRuntime Js

<div class="@DeskClass">
  <a class="skip" href="#shop" @onclick="SkipToShopAsync" @onclick:preventDefault>
    Skip to the shop
  </a>
  <TopBar />

  <main id="shop" class="sheet" tabindex="-1">
    <div class="sheet-head">
      <h1>Rubber Duck Supply Co.</h1>
      <div class="lede">
        <p>
          Hand-finished rubber ducks for people who explain their code out loud. The shop
          is built only from Ducky: switch on X-ray to see which part does what, and read
          the code that does it.
        </p>
        <p class="demo-note">
          Nothing here is for sale. The ducks, the stock and the orders are demonstration
          data from a fake API running in your browser, and Pay charges nothing.
        </p>
      </div>
    </div>
    <div class="shop-grid">
      <div class="shop-main">
        <SearchBar />
        <FiltersBar />
        <Shelf />
        <WarehouseDesk />
      </div>
      <div class="shop-side">
        <BasketPanel />
        <CheckoutBox />
        <OrderTracker />
        <ProfilePanel />
      </div>
    </div>
  </main>

  <BasketJump />
  <CodeDrawer />
  <InspectorTape />
</div>

@code {
  private Selection<XrayView> _view = null!;
  private Selection<bool> _drawerOpen = null!;

  private string DeskClass
  {
    get
    {
      string?[] classes =
      [
        "desk",
        _view.Value.On ? "xray" : null,
        _view.Value.InspectorOpen ? "inspector-open" : null,
        _drawerOpen.Value ? "with-drawer" : null,
      ];
      return string.Join(' ', classes.OfType<string>());
    }
  }

  protected override void OnInitialized()
  {
    _view = Select<XrayView, XrayView>(static view => view);
    _drawerOpen = Select<DrawerView, bool>(static drawer => drawer.Feature is not null);
  }

  // Under the base href, a bare "#shop" link would load another document when the URL
  // has a query (?devtools), so the script scrolls and focuses in place.
  private async Task SkipToShopAsync() =>
    await Js.InvokeVoidAsync("playground.jump", "shop");
}
