@page "/products"
@rendermode InteractiveAuto
@inherits DuckyComponent<ProductsState>

<PageTitle>Products</PageTitle>
<h1>Products</h1>
@if (State.Items is { } items)
{
    <ul data-testid="products">
        @foreach (var item in items)
        {
            <li>@item</li>
        }
    </ul>
}
else
{
    <p>Loading...</p>
}
@* The renderer that saw the store idle: "Static" in the prerendered HTML, then "Server" or "WebAssembly" once the
   interactive store's load effect, if any, has finished (the no-double-load specs read the server's load count then). *@
<p>Idle on <span data-testid="idle">@_idle</span>.</p>

@code {
    private string? _idle;

    // Wait for the load effect, so the prerendered HTML lists the products. After the seed restored the slice the effect
    // skips the load, so the interactive wait ends without a second one.
    protected override async Task OnInitializedAsync()
    {
        await Store.WhenIdleAsync();
        _idle = RendererInfo.Name;
    }
}
