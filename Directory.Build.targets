<Project>
  <!-- Analyzers and ban lists per project kind (SPEC §17.1, §18). Every rule is an error through TreatWarningsAsErrors. -->

  <!-- src/: public API tracking (RS0016/RS0017 raised to errors in .globalconfig), banned APIs (§10), threading analyzers.
       CA2007 is raised in .editorconfig [src/**.cs]. Generator projects also track their descriptors in
       AnalyzerReleases.*.md, which Microsoft.CodeAnalysis.Analyzers picks up from the project directory. -->
  <ItemGroup Condition="'$(DuckyIsSrcProject)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(RepoRoot)BannedSymbols.txt" />
  </ItemGroup>

  <!-- test/: no sleeps (§17.1); covered projects also ban the concurrency starters of test/BannedSymbols.covered.txt.
       The analyzer comes through CPM, so a project with CPM off (test/Ducky.PackageSmoke, §17.9) gets no versionless reference. -->
  <ItemGroup Condition="'$(DuckyIsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" Condition="'$(ManagePackageVersionsCentrally)' == 'true'" />
    <!-- TRX for every run; coverage only when the Test target asks for it, and never in Ducky.Concurrency.Tests (§17.3):
         there the coverage option fails as unknown. Ducky.AotSmoke is a plain NativeAOT console, not a test module (§10). -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Condition="'$(ManagePackageVersionsCentrally)' == 'true' and '$(MSBuildProjectName)' != 'Ducky.AotSmoke'" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Condition="'$(ManagePackageVersionsCentrally)' == 'true' and '$(MSBuildProjectName)' != 'Ducky.Concurrency.Tests' and '$(MSBuildProjectName)' != 'Ducky.AotSmoke'" />
    <AdditionalFiles Include="$(RepoRoot)test/BannedSymbols.txt" />
    <AdditionalFiles Include="$(RepoRoot)test/BannedSymbols.covered.txt" Condition="'$(MSBuildProjectName)' != 'Ducky.Concurrency.Tests'" />
  </ItemGroup>

  <!-- INV-24 (§19 Compile): every packable net10.0 src/ library is AOT-compatible with the trim, AOT and single-file
       analyzers on. The NoTargets tombstone has no assembly. -->
  <Target Name="DuckyRequireAotCompatible" BeforeTargets="CoreCompile"
          Condition="'$(DuckyIsSrcProject)' == 'true' and '$(IsPackable)' == 'true' and '$(TargetFramework)' == 'net10.0' and '$(UsingMicrosoftNoTargetsSdk)' != 'true' and ('$(IsAotCompatible)' != 'true' or '$(EnableTrimAnalyzer)' == 'false' or '$(EnableAotAnalyzer)' == 'false' or '$(EnableSingleFileAnalyzer)' == 'false')">
    <Error Text="$(MSBuildProjectName) is a packable net10.0 src/ project: it must set IsAotCompatible=true and keep the trim, AOT and single-file analyzers on (INV-24, §19 Compile)." />
  </Target>

  <!-- IsAotCompatible adds an implicit Microsoft.NET.ILLink.Tasks reference at the running SDK's runtime patch, and the
       lock files record it: without a pin, locked restore (CI=true) fails with NU1004 on any other 10.0.x SDK. Renovate
       bumps the value (.github/renovate.json); regenerate the lock files with it. -->
  <ItemGroup>
    <KnownILLinkPack Update="@(KnownILLinkPack)" ILLinkPackVersion="10.0.12" />
  </ItemGroup>

  <!-- In-repo generator consumers: generator assets never flow through a ProjectReference (R-PKG-5, §18). -->
  <ItemGroup Condition="'$(DuckyUseGenerators)' == 'true'">
    <ProjectReference Include="$(RepoRoot)src/Ducky.Generators/Ducky.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="$(RepoRoot)src/Ducky/buildTransitive/Ducky.targets" Condition="'$(DuckyUseGenerators)' == 'true'" />

  <ItemGroup Condition="'$(DuckyUseDraftGenerator)' == 'true'">
    <ProjectReference Include="$(RepoRoot)src/Ducky.Draft.Generators/Ducky.Draft.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="$(RepoRoot)src/Ducky.Draft/buildTransitive/Ducky.Draft.targets" Condition="'$(DuckyUseDraftGenerator)' == 'true'" />
</Project>
