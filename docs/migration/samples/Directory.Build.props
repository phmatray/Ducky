<Project>
  <!-- Migration samples (SPEC §17.1): Ducky.Migration.slnx, outside Ducky.slnx. There is no lock file, so a locked restore
       would fail; audit stays off, the "before" projects reference legacy packages on purpose. As PackageSmoke. The 2.0
       projects take their package versions from the root Directory.Packages.props, like test/; a "before" project turns
       central package management off in its own Directory.Build.props. -->
  <Import Project="../../../Directory.Build.props" />

  <PropertyGroup>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
    <NuGetAudit>false</NuGetAudit>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
</Project>
