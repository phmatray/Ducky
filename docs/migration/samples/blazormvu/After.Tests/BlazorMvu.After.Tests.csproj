<Project Sdk="Microsoft.NET.Sdk">
  <!-- The BlazorMVU After app's tests (SPEC §22.4): an xUnit v3 module on MTP like test/,
       run by the Docs target. The Ducky analyzers run, so the guide's snippets of these tests join the DUCKY001–003
       false-positive corpus (SPEC §16.2). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DuckyUseGenerators>true</DuckyUseGenerators>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../After/BlazorMvu.After.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Ducky.Testing/Ducky.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="bunit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
