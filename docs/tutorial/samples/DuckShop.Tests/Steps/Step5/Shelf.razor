@* The shelf as step 5 leaves it: the catalogue's ducks, with loading and error states.
   Step 6 puts the search box on top of it, step 7 shows only the ducks that match. *@
@* #region step5-shelf *@
@inherits DuckyComponent

@if (_catalogue.Value.Loading)
{
  <p class="status">Loading ducks…</p>
}
else if (_catalogue.Value.Error is { } error)
{
  <p class="status error">Couldn't load the ducks: @error</p>
}
else
{
  <section class="shelf">
    @foreach (var duck in _catalogue.Value.Ducks)
    {
      <DuckCard @key="duck.Id" Duck="duck" />
    }
  </section>
}

@code {
  private Selection<CatalogueState> _catalogue = null!;

  protected override void OnInitialized() =>
    _catalogue = Select((CatalogueState catalogue) => catalogue);
}
@* #endregion *@
