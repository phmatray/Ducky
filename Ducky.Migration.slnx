<Solution>
  <!-- The migration guides' compiled before/after samples (SPEC §17.1, §22): outside Ducky.slnx, built by the Docs target
       with an unlocked restore. "Before" references Ducky 1.x, Fluxor or TimeWarp.State from nuget.org with an explicit
       version, ASP.NET Core alone (the hand-written state container), or a vendored copy under
       docs/migration/samples/legacy/ for the libraries never published; "After" references src/. -->
  <!-- The src projects an After sample references, so the solution's Release configuration reaches them and reuses
       Compile's output (a ProjectReference outside the solution would build in its default Debug configuration). -->
  <Folder Name="/src/">
    <Project Path="src/Ducky/Ducky.csproj" />
    <Project Path="src/Ducky.Generators/Ducky.Generators.csproj" />
    <Project Path="src/Ducky.Blazor/Ducky.Blazor.csproj" />
    <Project Path="src/Ducky.Draft/Ducky.Draft.csproj" />
    <Project Path="src/Ducky.Draft.Generators/Ducky.Draft.Generators.csproj" />
    <Project Path="src/Ducky.Testing/Ducky.Testing.csproj" />
  </Folder>
  <Folder Name="/ducky-1x/">
    <Project Path="docs/migration/samples/ducky-1x/Before/Ducky1x.Before.csproj" />
    <Project Path="docs/migration/samples/ducky-1x/After/Ducky1x.After.csproj" />
    <Project Path="docs/migration/samples/ducky-1x/After.Tests/Ducky1x.After.Tests.csproj" />
  </Folder>
  <Folder Name="/fluxor/">
    <Project Path="docs/migration/samples/fluxor/Before/FluxorSample.Before.csproj" />
    <Project Path="docs/migration/samples/fluxor/After/FluxorSample.After.csproj" />
    <Project Path="docs/migration/samples/fluxor/After.Tests/FluxorSample.After.Tests.csproj" />
  </Folder>
  <Folder Name="/timewarp-state/">
    <Project Path="docs/migration/samples/timewarp-state/Before/TimeWarpSample.Before.csproj" />
    <Project Path="docs/migration/samples/timewarp-state/After/TimeWarpSample.After.csproj" />
    <Project Path="docs/migration/samples/timewarp-state/After.Tests/TimeWarpSample.After.Tests.csproj" />
  </Folder>
  <Folder Name="/state-container/">
    <Project Path="docs/migration/samples/state-container/Before/StateContainerSample.Before.csproj" />
    <Project Path="docs/migration/samples/state-container/After/StateContainerSample.After.csproj" />
    <Project Path="docs/migration/samples/state-container/After.Tests/StateContainerSample.After.Tests.csproj" />
  </Folder>
  <Folder Name="/mutty/">
    <Project Path="docs/migration/samples/mutty/Before/MuttySample.Before.csproj" />
    <Project Path="docs/migration/samples/mutty/After/MuttySample.After.csproj" />
    <Project Path="docs/migration/samples/mutty/After.Tests/MuttySample.After.Tests.csproj" />
  </Folder>
  <!-- The Bustand, TheBlazorState and BlazorMVU "before" apps build against verbatim copies of those libraries in
       docs/migration/samples/legacy/: none of them was published to nuget.org. -->
  <Folder Name="/legacy/">
    <Project Path="docs/migration/samples/legacy/Bustand/Bustand.csproj" />
    <Project Path="docs/migration/samples/legacy/TheBlazorState/TheBlazorState.csproj" />
    <Project Path="docs/migration/samples/legacy/TheBlazorState.Generators/TheBlazorState.Generators.csproj" />
    <Project Path="docs/migration/samples/legacy/BlazorMVU.Core/BlazorMVU.Core.csproj" />
  </Folder>
  <Folder Name="/bustand/">
    <Project Path="docs/migration/samples/bustand/Before/Bustand.Before.csproj" />
    <Project Path="docs/migration/samples/bustand/After/Bustand.After.csproj" />
    <Project Path="docs/migration/samples/bustand/After.Tests/Bustand.After.Tests.csproj" />
  </Folder>
  <Folder Name="/theblazorstate/">
    <Project Path="docs/migration/samples/theblazorstate/Before/TheBlazorState.Before.csproj" />
    <Project Path="docs/migration/samples/theblazorstate/After/TheBlazorState.After.csproj" />
    <Project Path="docs/migration/samples/theblazorstate/After.Tests/TheBlazorState.After.Tests.csproj" />
  </Folder>
  <Folder Name="/blazormvu/">
    <Project Path="docs/migration/samples/blazormvu/Before/BlazorMvu.Before.csproj" />
    <Project Path="docs/migration/samples/blazormvu/After/BlazorMvu.After.csproj" />
    <Project Path="docs/migration/samples/blazormvu/After.Tests/BlazorMvu.After.Tests.csproj" />
  </Folder>
</Solution>
